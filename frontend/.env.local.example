# Base URL of the guentours-api Spring Boot backend (no trailing slash).
# Used both server-side and client-side (NEXT_PUBLIC_ prefix), including for the
# EventSource booking-tracking stream, which the browser must reach directly.
NEXT_PUBLIC_API_URL=http://localhost:8080

# This site's own public base URL (no trailing slash) - used for metadataBase, sitemap.xml and
# robots.txt absolute URLs. Set to the real production domain when deploying.
NEXT_PUBLIC_APP_URL=http://localhost:3000
